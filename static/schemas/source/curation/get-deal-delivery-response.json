{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/curation/get-deal-delivery-response.json",
  "title": "Get Deal Delivery Response",
  "description": "Response payload for get_deal_delivery task. Returns SSP-side delivery metrics for deals including curation-specific metrics (bids, wins, win_rate) not found in media-buy delivery.",
  "type": "object",
  "properties": {
    "reporting_period": {
      "type": "object",
      "description": "The reporting period covered by this response",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Start date (YYYY-MM-DD)"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "End date (YYYY-MM-DD)"
        }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "currency": {
      "type": "string",
      "description": "ISO 4217 currency code for all monetary values in this response",
      "pattern": "^[A-Z]{3}$"
    },
    "deal_deliveries": {
      "type": "array",
      "description": "Delivery data for each requested deal",
      "items": {
        "type": "object",
        "properties": {
          "deal_id": {
            "type": "string",
            "description": "Protocol-level deal identifier"
          },
          "buyer_ref": {
            "type": "string",
            "description": "Buyer's reference identifier"
          },
          "status": {
            "$ref": "/schemas/enums/deal-status.json",
            "description": "Current deal status"
          },
          "totals": {
            "type": "object",
            "description": "Aggregate delivery metrics for the reporting period",
            "properties": {
              "impressions": {
                "type": "integer",
                "description": "Total impressions delivered",
                "minimum": 0
              },
              "spend": {
                "type": "number",
                "description": "Total spend in the reported currency",
                "minimum": 0
              },
              "bids": {
                "type": "integer",
                "description": "Total bid requests sent to DSPs for this deal",
                "minimum": 0
              },
              "wins": {
                "type": "integer",
                "description": "Total auction wins",
                "minimum": 0
              },
              "win_rate": {
                "type": "number",
                "description": "Win rate as a decimal (wins / bids). 0.05 = 5% win rate.",
                "minimum": 0,
                "maximum": 1
              },
              "avg_cpm": {
                "type": "number",
                "description": "Average clearing CPM",
                "minimum": 0
              }
            },
            "required": ["impressions", "spend"],
            "additionalProperties": true
          },
          "by_dsp": {
            "type": "array",
            "description": "Per-DSP breakdown of delivery metrics",
            "items": {
              "type": "object",
              "properties": {
                "dsp_id": {
                  "oneOf": [
                    { "type": "integer" },
                    { "type": "string" }
                  ]
                },
                "dsp_name": {
                  "type": "string"
                },
                "impressions": {
                  "type": "integer",
                  "minimum": 0
                },
                "spend": {
                  "type": "number",
                  "minimum": 0
                },
                "bids": {
                  "type": "integer",
                  "minimum": 0
                },
                "wins": {
                  "type": "integer",
                  "minimum": 0
                },
                "win_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "avg_cpm": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["dsp_name"],
              "additionalProperties": true
            }
          },
          "daily_breakdown": {
            "type": "array",
            "description": "Daily breakdown of delivery metrics. Only present when include_daily_breakdown is true.",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "description": "Date (YYYY-MM-DD)"
                },
                "impressions": {
                  "type": "integer",
                  "minimum": 0
                },
                "spend": {
                  "type": "number",
                  "minimum": 0
                },
                "bids": {
                  "type": "integer",
                  "minimum": 0
                },
                "wins": {
                  "type": "integer",
                  "minimum": 0
                },
                "win_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "avg_cpm": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["date"],
              "additionalProperties": true
            }
          }
        },
        "required": ["deal_id", "status"],
        "additionalProperties": true
      }
    },
    "errors": {
      "type": "array",
      "description": "Task-specific errors and warnings",
      "items": {
        "$ref": "/schemas/core/error.json"
      }
    },
    "sandbox": {
      "type": "boolean",
      "description": "When true, this response contains simulated data from sandbox mode."
    },
    "context": {
      "$ref": "/schemas/core/context.json"
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    }
  },
  "required": [
    "reporting_period",
    "currency",
    "deal_deliveries"
  ],
  "additionalProperties": true
}
